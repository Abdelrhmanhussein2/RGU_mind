@baseUrl = http://127.0.0.1:5000
@departmentId = 63bf01c6-9605-4257-a920-9cf8da913dc5

### 1. Register a new student
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "test_student",
    "email": "student@example.com",
    "password": "password123",
    "university_name": "My University",
    "faculty": "Engineering"
}

###

### 2. Student Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email_or_username": "test_student",
    "password": "password123"
}

###

### 3. Register a new university
POST {{baseUrl}}/auth/university/register
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="name"

Tanta University
--boundary
Content-Disposition: form-data; name="slug"

tanta-university
--boundary
Content-Disposition: form-data; name="country"

Egypt
--boundary
Content-Disposition: form-data; name="contact_email"

contact@tanta.edu.eg
--boundary
Content-Disposition: form-data; name="password"

password123
--boundary
Content-Disposition: form-data; name="verification_file"; filename="test.txt"
Content-Type: text/plain

<This is a dummy text file to act as the uploaded verification document.>
--boundary--

###

### 4. University Login
POST {{baseUrl}}/auth/university/login
Content-Type: application/json

{
    "email_or_username": "tanta-university",
    "password": "password123"
}

###

### 5. Upload Regulation File
# Replace @departmentId above with a real department id from your database.
POST {{baseUrl}}/data/upload?department_id={{departmentId}}&title=Sample%20Regulation&version=1.0
Content-Type: multipart/form-data; boundary=----RGUMindBoundary

------RGUMindBoundary
Content-Disposition: form-data; name="file"; filename="test_upload.txt"
Content-Type: text/plain

This is a test regulation document for the upload endpoint.
------RGUMindBoundary--

###

### 6. Extract Chunks
# Replace documentId with a real document_id from your database.
@documentId = c1bf01c6-9605-4257-a920-9cf8da913dcd
POST {{baseUrl}}/data/{{documentId}}/chunk

###

### 7. Admin: Create a new admin
POST {{baseUrl}}/admin/create-admin
Content-Type: application/json
x-admin-id: <PASTE_SUPER_ADMIN_ID_HERE>

{
    "name": "Regular Admin",
    "email": "admin@example.com",
    "password": "adminpassword"
}

###

### 8. Admin: Approve University
POST {{baseUrl}}/admin/approve-university/<PASTE_UNIVERSITY_ID_HERE>
x-admin-id: <PASTE_ADMIN_ID_HERE>

###

### 9. Admin: Reject University
POST {{baseUrl}}/admin/reject-university/<PASTE_UNIVERSITY_ID_HERE>
x-admin-id: <PASTE_ADMIN_ID_HERE>

###

### 10. Retrieval
POST {{baseUrl}}/retrieval
Content-Type: application/json

{
    "query": "what is this document about?",
    "Top_k": 5,
    "department_id": "{{departmentId}}"
}
